    {
      "id": "gMTlV9LUW4cne5tq4vca1",
      "type": "text",
      "x": 2781.04009931957,
      "y": 10203.336688578038,
      "width": 2952.439731067266,
      "height": 5416.663311421961,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "1FPfUPTCMxvxBbDQeQYQQ",
      "index": "bTCV",
      "roundness": null,
      "seed": 931296477,
      "version": 57,
      "versionNonce": 591178013,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769070697588,
      "link": null,
      "locked": false,
      "text": "class MedianFinder {\n    List<Integer> list;\n    // []\n    // 1 call: T: O(1), S: O(1)\n    public MedianFinder() {\n        list = new ArrayList<Integer>();\n    }\n\n    // 1 call: T: O(1), S: O(1)\n    // n calls: T: O(n), S: O(n)\n    // 3 8 1\n    // [3, 8, 1]\n    public void addNum(int num) {\n        list.add(num);\n    }\n\n    // 1 call: T: O(m.logm), S: O(logm)\n    // n calls: T: O(n.m.logm), S: (n.logm)\n    // [1 3 8]\n    // n = 3\n    // \n    public double findMedian() {\n        Collections.sort(list);\n\n        int n = list.size();\n        if (n % 2 == 0) {\n            // even\n            // n/2... 4/2 -> 2\n            // 0 1 2 3\n            // 1 2\n            // n/2 - 1\n            return (list.get(n / 2) + list.get(n / 2 - 1)) / 2.0;\n        }\n\n        // odd\n        // 5\n        // [1 3 8 9 20]\n        //  0 1 2 3 4\n        return list.get(n / 2);\n    }\n}\n\n/**\n * Your MedianFinder object will be instantiated and called as such:\n * MedianFinder obj = new MedianFinder();\n * obj.addNum(num);\n * double param_2 = obj.findMedian();\n */",
      "fontSize": 90.27772185703265,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class MedianFinder {\n    List<Integer> list;\n    // []\n    // 1 call: T: O(1), S: O(1)\n    public MedianFinder() {\n        list = new ArrayList<Integer>();\n    }\n\n    // 1 call: T: O(1), S: O(1)\n    // n calls: T: O(n), S: O(n)\n    // 3 8 1\n    // [3, 8, 1]\n    public void addNum(int num) {\n        list.add(num);\n    }\n\n    // 1 call: T: O(m.logm), S: O(logm)\n    // n calls: T: O(n.m.logm), S: (n.logm)\n    // [1 3 8]\n    // n = 3\n    // \n    public double findMedian() {\n        Collections.sort(list);\n\n        int n = list.size();\n        if (n % 2 == 0) {\n            // even\n            // n/2... 4/2 -> 2\n            // 0 1 2 3\n            // 1 2\n            // n/2 - 1\n            return (list.get(n / 2) + list.get(n / 2 - 1)) / 2.0;\n        }\n\n        // odd\n        // 5\n        // [1 3 8 9 20]\n        //  0 1 2 3 4\n        return list.get(n / 2);\n    }\n}\n\n/**\n * Your MedianFinder object will be instantiated and called as such:\n * MedianFinder obj = new MedianFinder();\n * obj.addNum(num);\n * double param_2 = obj.findMedian();\n */",
      "autoResize": true,
      "lineHeight": 1.25
    },
