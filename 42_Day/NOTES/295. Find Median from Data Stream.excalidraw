    {
      "id": "XTrjqX_A025aR4v8v9se1",
      "type": "text",
      "x": 3521.04009931957,
      "y": 47863.33668857804,
      "width": 3232.11669921875,
      "height": 8124.994967132938,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "UrOK8KkjV-H4sxdNkC0dk",
      "index": "bTDG",
      "roundness": null,
      "seed": 841343795,
      "version": 232,
      "versionNonce": 1220990579,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769075725834,
      "link": null,
      "locked": false,
      "text": "class MedianFinder {\n    // min heap\n    // max heap\n    PriorityQueue<Integer> minHeap;\n    PriorityQueue<Integer> maxHeap;\n    \n    // T: O(1), S: O(1)\n    public MedianFinder() {\n        minHeap = new PriorityQueue<Integer>();\n        maxHeap = new PriorityQueue<Integer>(Collections.reverseOrder());\n    }\n    \n    // 1 call: T: O(logn), S: O(1)\n    // m calls: T: O(m.logm), S: O(m)\n    // [2, 1, 3]\n    // <1> <2>\n    // \n    public void addNum(int num) {\n        // even\n        // 10 ... 10\n        // 1\n        // <>, <>\n        // even\n        // 0 0\n        // 1 0\n        // maxHeap size == minHeap + 1\n        // \n        if (maxHeap.size() == 0) {\n            maxHeap.add(num);\n            return;\n        }\n        \n        if (maxHeap.size() == minHeap.size()) {\n            // num\n            // [2, 1, 3]\n            // <1, 2> <3>\n            // \n            if (num > maxHeap.peek()) {\n                // 10 ... 10\n                minHeap.add(num);\n                // 10 ... 11\n                // \n                maxHeap.add(minHeap.poll());\n            } else {\n                // num <= maxHeap.peek\n                maxHeap.add(num);\n                // 11 ... 10\n            }\n        } else {\n            // odd\n            maxHeap.add(num);\n            // 11 ... 10\n            // 12 ... 10\n            minHeap.add(maxHeap.poll());\n        }\n    }\n    \n    public double findMedian() {\n        if (maxHeap.size() == minHeap.size()) {\n            return (maxHeap.peek() + minHeap.peek()) / 2.0;\n        }\n\n        return maxHeap.peek();\n    }\n}\n\n/**\n * Your MedianFinder object will be instantiated and called as such:\n * MedianFinder obj = new MedianFinder();\n * obj.addNum(num);\n * double param_2 = obj.findMedian();\n */",
      "fontSize": 90.27772185703265,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class MedianFinder {\n    // min heap\n    // max heap\n    PriorityQueue<Integer> minHeap;\n    PriorityQueue<Integer> maxHeap;\n    \n    // T: O(1), S: O(1)\n    public MedianFinder() {\n        minHeap = new PriorityQueue<Integer>();\n        maxHeap = new PriorityQueue<Integer>(Collections.reverseOrder());\n    }\n    \n    // 1 call: T: O(logn), S: O(1)\n    // m calls: T: O(m.logm), S: O(m)\n    // [2, 1, 3]\n    // <1> <2>\n    // \n    public void addNum(int num) {\n        // even\n        // 10 ... 10\n        // 1\n        // <>, <>\n        // even\n        // 0 0\n        // 1 0\n        // maxHeap size == minHeap + 1\n        // \n        if (maxHeap.size() == 0) {\n            maxHeap.add(num);\n            return;\n        }\n        \n        if (maxHeap.size() == minHeap.size()) {\n            // num\n            // [2, 1, 3]\n            // <1, 2> <3>\n            // \n            if (num > maxHeap.peek()) {\n                // 10 ... 10\n                minHeap.add(num);\n                // 10 ... 11\n                // \n                maxHeap.add(minHeap.poll());\n            } else {\n                // num <= maxHeap.peek\n                maxHeap.add(num);\n                // 11 ... 10\n            }\n        } else {\n            // odd\n            maxHeap.add(num);\n            // 11 ... 10\n            // 12 ... 10\n            minHeap.add(maxHeap.poll());\n        }\n    }\n    \n    public double findMedian() {\n        if (maxHeap.size() == minHeap.size()) {\n            return (maxHeap.peek() + minHeap.peek()) / 2.0;\n        }\n\n        return maxHeap.peek();\n    }\n}\n\n/**\n * Your MedianFinder object will be instantiated and called as such:\n * MedianFinder obj = new MedianFinder();\n * obj.addNum(num);\n * double param_2 = obj.findMedian();\n */",
      "autoResize": true,
      "lineHeight": 1.25
    },
