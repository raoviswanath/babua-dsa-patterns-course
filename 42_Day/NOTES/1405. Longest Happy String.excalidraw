      "width": 5872.826171875,
      "height": 10011.862097276598,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "zXhCbccG7WUbkXUpG8N0K",
      "index": "bmMG",
      "roundness": null,
      "seed": 1748268499,
      "version": 140,
      "versionNonce": 1480523891,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769067968454,
      "link": null,
      "locked": false,
      "text": "class CharacterCount {\n    int count;\n    char c;\n\n    public CharacterCount(int _count, char _c) {\n        count = _count;\n        c = _c;\n    }\n}\n\nclass Solution {\n    public String longestDiverseString(int a, int b, int c) {\n        // Max Heap... element... value... character\n        // max element... character\n        // a = 1, b = 1, c = 2\n        PriorityQueue<CharacterCount> maxHeap = new PriorityQueue<CharacterCount>((x, y) -> y.count - x.count);\n\n        // heap.. khali dabba nahi dalenge\n        if (a > 0) {\n            maxHeap.add(new CharacterCount(a, 'a'));\n        }\n        if (b > 0) {\n            maxHeap.add(new CharacterCount(b, 'b'));\n        }\n        if (c > 0) {\n            maxHeap.add(new CharacterCount(c, 'c'));\n        }\n\n        // <1:a, 1:b, 2:c>\n        // \"\"\n        StringBuilder res = new StringBuilder();\n\n\n        // <>\n        // \"ccba\"\n        // maxEle = 0:a\n        // multiple examples...\n        // T: O(a + b + c), S: O(1)\n        while (!maxHeap.isEmpty()) {\n            CharacterCount maxEle = maxHeap.poll();\n\n            int count = maxEle.count;\n            char _c = maxEle.c;\n            // \"cc\"\n            // c\n            // \"kk\"\n            if (res.length() >= 2 && res.charAt(res.length() - 1) == _c && res.charAt(res.length() - 2) == _c) {\n                if (maxHeap.isEmpty()) {\n                    break;\n                }\n\n                CharacterCount secondMaxEle = maxHeap.poll();\n\n                int sCount = secondMaxEle.count;\n                char sC = secondMaxEle.c;\n\n                res.append(sC);\n\n                sCount = sCount - 1;\n\n                if (sCount > 0) {\n                    maxHeap.add(new CharacterCount(sCount, sC));\n                }\n            } else {\n                res.append(_c);\n                count = count - 1;\n            }\n\n            if (count > 0) {\n                maxHeap.add(new CharacterCount(count, _c));\n            }\n        }\n\n        return res.toString();\n    }\n}",
      "fontSize": 105.38802207659577,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class CharacterCount {\n    int count;\n    char c;\n\n    public CharacterCount(int _count, char _c) {\n        count = _count;\n        c = _c;\n    }\n}\n\nclass Solution {\n    public String longestDiverseString(int a, int b, int c) {\n        // Max Heap... element... value... character\n        // max element... character\n        // a = 1, b = 1, c = 2\n        PriorityQueue<CharacterCount> maxHeap = new PriorityQueue<CharacterCount>((x, y) -> y.count - x.count);\n\n        // heap.. khali dabba nahi dalenge\n        if (a > 0) {\n            maxHeap.add(new CharacterCount(a, 'a'));\n        }\n        if (b > 0) {\n            maxHeap.add(new CharacterCount(b, 'b'));\n        }\n        if (c > 0) {\n            maxHeap.add(new CharacterCount(c, 'c'));\n        }\n\n        // <1:a, 1:b, 2:c>\n        // \"\"\n        StringBuilder res = new StringBuilder();\n\n\n        // <>\n        // \"ccba\"\n        // maxEle = 0:a\n        // multiple examples...\n        // T: O(a + b + c), S: O(1)\n        while (!maxHeap.isEmpty()) {\n            CharacterCount maxEle = maxHeap.poll();\n\n            int count = maxEle.count;\n            char _c = maxEle.c;\n            // \"cc\"\n            // c\n            // \"kk\"\n            if (res.length() >= 2 && res.charAt(res.length() - 1) == _c && res.charAt(res.length() - 2) == _c) {\n                if (maxHeap.isEmpty()) {\n                    break;\n                }\n\n                CharacterCount secondMaxEle = maxHeap.poll();\n\n                int sCount = secondMaxEle.count;\n                char sC = secondMaxEle.c;\n\n                res.append(sC);\n\n                sCount = sCount - 1;\n\n                if (sCount > 0) {\n                    maxHeap.add(new CharacterCount(sCount, sC));\n                }\n            } else {\n                res.append(_c);\n                count = count - 1;\n            }\n\n            if (count > 0) {\n                maxHeap.add(new CharacterCount(count, _c));\n            }\n        }\n\n        return res.toString();\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
