      "text": "class Solution {\n    public String longestDiverseString(int a, int b, int c) {\n        // c_a\n        // c_b\n        // c_c\n        // StringBuilder\n        // loop\n        //      a ko kha sakte hai?\n        //      b ko kha sakte hai?\n        //      c ko kha sakte hai?\n        //      XXX\n        // string\n        int c_a = 0,\n            c_b = 0,\n            c_c = 0;\n\n        // a + b + c\n        // T: O(a + b + c), S: O(a + b + c/1)\n        // a = 3, b = 0, c = 0\n        // \"aabaa\"\n        // c_a = 2\n        // c_b = 0\n        // c_c = 0\n        // \n        StringBuilder res = new StringBuilder();\n        while (true) {\n            if (a > 0 && (\n                (a >= b && a >= c && c_a < 2) ||\n                (c_b == 2 && b >= a && a >= c) ||\n                (c_c == 2 && c >= a && a >= b)\n            )) {\n                res.append('a');\n                \n                c_a = c_a + 1;\n                c_b = 0;\n                c_c = 0;\n\n                a = a - 1;\n            } else if (b > 0 && (\n                (b >= a && b >= c && c_b < 2) ||\n                (c_a == 2 && a >= b && b >= c) ||\n                (c_c == 2 && c >= b && b >= a))) {\n                res.append('b');\n                \n                c_b = c_b + 1;\n                c_a = 0;\n                c_c = 0;\n\n                b = b - 1;\n            } else if (c > 0 && (\n                (c >= b && c >= a && c_c < 2) ||\n                (c_a == 2 && a >= c && c >= b) ||\n                (c_b == 2 && b >= c && c >= a)\n                )\n            ) {\n                res.append('c');\n                \n                c_a = 0;\n                c_b = 0;\n                c_c = c_c + 1;\n\n                c = c - 1;\n            } else {\n                break;\n            }\n        }\n\n        return res.toString();\n    }\n}",
      "fontSize": 105.38802207659577,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public String longestDiverseString(int a, int b, int c) {\n        // c_a\n        // c_b\n        // c_c\n        // StringBuilder\n        // loop\n        //      a ko kha sakte hai?\n        //      b ko kha sakte hai?\n        //      c ko kha sakte hai?\n        //      XXX\n        // string\n        int c_a = 0,\n            c_b = 0,\n            c_c = 0;\n\n        // a + b + c\n        // T: O(a + b + c), S: O(a + b + c/1)\n        // a = 3, b = 0, c = 0\n        // \"aabaa\"\n        // c_a = 2\n        // c_b = 0\n        // c_c = 0\n        // \n        StringBuilder res = new StringBuilder();\n        while (true) {\n            if (a > 0 && (\n                (a >= b && a >= c && c_a < 2) ||\n                (c_b == 2 && b >= a && a >= c) ||\n                (c_c == 2 && c >= a && a >= b)\n            )) {\n                res.append('a');\n                \n                c_a = c_a + 1;\n                c_b = 0;\n                c_c = 0;\n\n                a = a - 1;\n            } else if (b > 0 && (\n                (b >= a && b >= c && c_b < 2) ||\n                (c_a == 2 && a >= b && b >= c) ||\n                (c_c == 2 && c >= b && b >= a))) {\n                res.append('b');\n                \n                c_b = c_b + 1;\n                c_a = 0;\n                c_c = 0;\n\n                b = b - 1;\n            } else if (c > 0 && (\n                (c >= b && c >= a && c_c < 2) ||\n                (c_a == 2 && a >= c && c >= b) ||\n                (c_b == 2 && b >= c && c >= a)\n                )\n            ) {\n                res.append('c');\n                \n                c_a = 0;\n                c_b = 0;\n                c_c = c_c + 1;\n\n                c = c - 1;\n            } else {\n                break;\n            }\n        }\n\n        return res.toString();\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
