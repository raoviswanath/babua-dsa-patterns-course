    {
      "id": "Gb76izqRT9Q15lhgcQ_G3",
      "type": "text",
      "x": 3964.5614974072623,
      "y": 19273.0786826699,
      "width": 5694.583691715959,
      "height": 8906.9213173301,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "0hfmzrpmGdEHwNRVOJXXT",
      "index": "c06KV",
      "roundness": null,
      "seed": 921914655,
      "version": 41,
      "versionNonce": 966218623,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770799536604,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public double[] medianSlidingWindow(int[] nums, int k) {\n        // nums = [1,3,-1,-3,5,3,6,7], k = 3\n        int n = nums.length;\n\n        double[] res = new double[n - k + 1];\n\n        int j = 0;\n\n        int[] window = new int[k];\n        // T: O(k), S: O(k)\n        // nums = [1,3,-1,-3,5,3,6,7], k = 3\n        //          \n        // window = [1, 3, -1]\n        for (int i = 0; i < k; i = i + 1) {\n            window[i] = nums[i];\n        }\n        // nums = [1,3,-1,-3], k = 3\n        // window = [1, 3, -1]\n        // res = [0,0]\n        // window = [-1, 1, 3]\n        // odd -> n/2th element\n        // [1, 1, 2, 3]\n        //. 0. 1. 2. 3\n        // k = 4\n\n        // nums = [1,3,-1,-3], k = 3\n        // window = [-1, 1, 3]\n        // res = [1,0]\n        //        j\n        Arrays.sort(window);\n\n        res[j] = k % 2 == 1 ? window[k / 2] : ((double) window[k / 2] + window[k / 2 - 1]) / 2.0;\n        // nums = [1,3,-1,-3], k = 3\n        //         0.1. 2. 3    \n\n        //         0 1. 2. 3\n        // nums = [1,3,-1,-3], k = 3\n        //                 i\n        //           l\n        // window = [3, -1, -3] -> [-3, -1, 3]\n        //           m\n        // res = [1,-1]\n        //          j      \n        // T: O(k), S: O(k)\n        // n * (n/2 + n/2log(n/2))\n        // T: O(n^2.logn), S: O(k + sorting space complexity)\n        for (int i = k; i < n; i = i + 1) {\n            int m = 0;\n            for (int l = i - k + 1; l <= i; l = l + 1) {\n                window[m] = nums[l];\n                m = m + 1;\n            }\n            Arrays.sort(window);\n            j = j + 1;\n            res[j] = k % 2 == 1 ? window[k / 2] : ((double) window[k / 2] + window[k / 2 - 1]) / 2.0;\n        }\n\n        return res;\n    }\n}",
      "fontSize": 116.81208285023084,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public double[] medianSlidingWindow(int[] nums, int k) {\n        // nums = [1,3,-1,-3,5,3,6,7], k = 3\n        int n = nums.length;\n\n        double[] res = new double[n - k + 1];\n\n        int j = 0;\n\n        int[] window = new int[k];\n        // T: O(k), S: O(k)\n        // nums = [1,3,-1,-3,5,3,6,7], k = 3\n        //          \n        // window = [1, 3, -1]\n        for (int i = 0; i < k; i = i + 1) {\n            window[i] = nums[i];\n        }\n        // nums = [1,3,-1,-3], k = 3\n        // window = [1, 3, -1]\n        // res = [0,0]\n        // window = [-1, 1, 3]\n        // odd -> n/2th element\n        // [1, 1, 2, 3]\n        //. 0. 1. 2. 3\n        // k = 4\n\n        // nums = [1,3,-1,-3], k = 3\n        // window = [-1, 1, 3]\n        // res = [1,0]\n        //        j\n        Arrays.sort(window);\n\n        res[j] = k % 2 == 1 ? window[k / 2] : ((double) window[k / 2] + window[k / 2 - 1]) / 2.0;\n        // nums = [1,3,-1,-3], k = 3\n        //         0.1. 2. 3    \n\n        //         0 1. 2. 3\n        // nums = [1,3,-1,-3], k = 3\n        //                 i\n        //           l\n        // window = [3, -1, -3] -> [-3, -1, 3]\n        //           m\n        // res = [1,-1]\n        //          j      \n        // T: O(k), S: O(k)\n        // n * (n/2 + n/2log(n/2))\n        // T: O(n^2.logn), S: O(k + sorting space complexity)\n        for (int i = k; i < n; i = i + 1) {\n            int m = 0;\n            for (int l = i - k + 1; l <= i; l = l + 1) {\n                window[m] = nums[l];\n                m = m + 1;\n            }\n            Arrays.sort(window);\n            j = j + 1;\n            res[j] = k % 2 == 1 ? window[k / 2] : ((double) window[k / 2] + window[k / 2 - 1]) / 2.0;\n        }\n\n        return res;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
