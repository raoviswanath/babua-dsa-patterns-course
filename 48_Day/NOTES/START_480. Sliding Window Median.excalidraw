    {
      "id": "q15CEi-8dGvEepyt0pwK7",
      "type": "text",
      "x": 4684.561497407263,
      "y": 133033.0786826699,
      "width": 6721.5986328125,
      "height": 18689.933256036933,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "1P21xWuN5lPpRcBBQYsBK",
      "index": "c06Lzd",
      "roundness": null,
      "seed": 2092301500,
      "version": 466,
      "versionNonce": 220251268,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771223441942,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public double[] medianSlidingWindow(int[] nums, int k) {\n        // k window\n        // find median from data stream code...\n        // maxheap, min heap\n        // map <element, freq> -> memory to say which elements are yet to be deleted\n        // tab delete karenge jab yeh max heap ya min heap mai sabse top pe aa jayenge\n        // min heap\n        // max heap\n        // [1,3,-1,-3]\n        // k = 3\n        // <> <>\n        PriorityQueue<Integer> minHeap = new PriorityQueue<Integer>();\n        PriorityQueue<Integer> maxHeap = new PriorityQueue<Integer>(Collections.reverseOrder());\n\n        // k elements\n        // k = n/2\n        // T: O(n.logn), S: O(n)\n        for (int i = 0; i < k; i = i + 1) {\n            int num = nums[i];\n            if (maxHeap.size() == 0) {\n                maxHeap.add(num);\n                continue;\n            }\n            \n            if (maxHeap.size() == minHeap.size()) {\n                // num\n                // [2, 1, 3]\n                // <1, 2> <3>\n                // \n                if (num > maxHeap.peek()) {\n                    // 10 ... 10\n                    minHeap.add(num);\n                    // 10 ... 11\n                    // \n                    maxHeap.add(minHeap.poll());\n                } else {\n                    // num <= maxHeap.peek\n                    maxHeap.add(num);\n                    // 11 ... 10\n                }\n            } else {\n                // odd\n                maxHeap.add(num);\n                // 11 ... 10\n                // 12 ... 10\n                minHeap.add(maxHeap.poll());\n            }\n        }\n\n        // [1,3,-1,-3]\n        // k = 3\n        // <-1 1> <3>\n        // res = [1, 0]\n        int n = nums.length;\n        double[] res = new double[n - k + 1];\n        int j = 0;\n\n        Map<Integer, Integer> map = new HashMap<>();\n\n        res[j] = k % 2 == 1 ? maxHeap.peek() : ((double) maxHeap.peek() + minHeap.peek()) / 2;\n\n        // 1 2 3 4\n        //  0 1. 2. 3\n        // [1,3,-1,-3]\n        //          i\n        // k = 3\n        // numA = -3\n        // numR = 1\n        // <1: 0>\n        // <-1, -3> <3>\n        // counter = 0\n        // res = [1, 0]\n        // T: O(n.logn), S: O(n)\n        for (int i = k; i < n; i = i + 1) {\n            int numA = nums[i],\n                numR = nums[i - k];\n\n            map.put(numR, map.getOrDefault(numR, 0) + 1);\n\n            int counter = 0;\n            // maxHeap -> Add +1, Remove -1\n            // minHeap -> Add -1, Remove +1\n\n            if (numA <= maxHeap.peek()) {\n                maxHeap.add(numA);\n                counter = counter + 1;\n            } else {\n                minHeap.add(numA);\n                counter = counter - 1;\n            }\n\n            if (numR <= maxHeap.peek()) {\n                counter = counter - 1;\n            } else {\n                counter = counter + 1;\n            }\n\n            // counter = 0, +, -\n            if (counter > 0) {\n                minHeap.add(maxHeap.poll());\n            }\n\n            if (counter < 0) {\n                maxHeap.add(minHeap.poll());\n            }\n\n            // median calculation tab karenge jab stale elements aur wo top pe hai heaps ke... pehle unhe remove kar lo...\n            while (!maxHeap.isEmpty() && map.getOrDefault(maxHeap.peek(), 0) > 0) {\n                int ele = maxHeap.peek();\n                maxHeap.poll();\n                map.put(ele, map.get(ele) - 1);\n            }\n\n            while (!minHeap.isEmpty() && map.getOrDefault(minHeap.peek(), 0) > 0) {\n                int ele = minHeap.peek();\n                minHeap.poll();\n                map.put(ele, map.get(ele) - 1);\n            }\n\n            j = j + 1;\n            res[j] = k % 2 == 1 ? maxHeap.peek() : ((double) maxHeap.peek() + minHeap.peek()) / 2;\n        }\n\n        return res;\n        \n    }\n}",
      "fontSize": 116.81208285023084,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public double[] medianSlidingWindow(int[] nums, int k) {\n        // k window\n        // find median from data stream code...\n        // maxheap, min heap\n        // map <element, freq> -> memory to say which elements are yet to be deleted\n        // tab delete karenge jab yeh max heap ya min heap mai sabse top pe aa jayenge\n        // min heap\n        // max heap\n        // [1,3,-1,-3]\n        // k = 3\n        // <> <>\n        PriorityQueue<Integer> minHeap = new PriorityQueue<Integer>();\n        PriorityQueue<Integer> maxHeap = new PriorityQueue<Integer>(Collections.reverseOrder());\n\n        // k elements\n        // k = n/2\n        // T: O(n.logn), S: O(n)\n        for (int i = 0; i < k; i = i + 1) {\n            int num = nums[i];\n            if (maxHeap.size() == 0) {\n                maxHeap.add(num);\n                continue;\n            }\n            \n            if (maxHeap.size() == minHeap.size()) {\n                // num\n                // [2, 1, 3]\n                // <1, 2> <3>\n                // \n                if (num > maxHeap.peek()) {\n                    // 10 ... 10\n                    minHeap.add(num);\n                    // 10 ... 11\n                    // \n                    maxHeap.add(minHeap.poll());\n                } else {\n                    // num <= maxHeap.peek\n                    maxHeap.add(num);\n                    // 11 ... 10\n                }\n            } else {\n                // odd\n                maxHeap.add(num);\n                // 11 ... 10\n                // 12 ... 10\n                minHeap.add(maxHeap.poll());\n            }\n        }\n\n        // [1,3,-1,-3]\n        // k = 3\n        // <-1 1> <3>\n        // res = [1, 0]\n        int n = nums.length;\n        double[] res = new double[n - k + 1];\n        int j = 0;\n\n        Map<Integer, Integer> map = new HashMap<>();\n\n        res[j] = k % 2 == 1 ? maxHeap.peek() : ((double) maxHeap.peek() + minHeap.peek()) / 2;\n\n        // 1 2 3 4\n        //  0 1. 2. 3\n        // [1,3,-1,-3]\n        //          i\n        // k = 3\n        // numA = -3\n        // numR = 1\n        // <1: 0>\n        // <-1, -3> <3>\n        // counter = 0\n        // res = [1, 0]\n        // T: O(n.logn), S: O(n)\n        for (int i = k; i < n; i = i + 1) {\n            int numA = nums[i],\n                numR = nums[i - k];\n\n            map.put(numR, map.getOrDefault(numR, 0) + 1);\n\n            int counter = 0;\n            // maxHeap -> Add +1, Remove -1\n            // minHeap -> Add -1, Remove +1\n\n            if (numA <= maxHeap.peek()) {\n                maxHeap.add(numA);\n                counter = counter + 1;\n            } else {\n                minHeap.add(numA);\n                counter = counter - 1;\n            }\n\n            if (numR <= maxHeap.peek()) {\n                counter = counter - 1;\n            } else {\n                counter = counter + 1;\n            }\n\n            // counter = 0, +, -\n            if (counter > 0) {\n                minHeap.add(maxHeap.poll());\n            }\n\n            if (counter < 0) {\n                maxHeap.add(minHeap.poll());\n            }\n\n            // median calculation tab karenge jab stale elements aur wo top pe hai heaps ke... pehle unhe remove kar lo...\n            while (!maxHeap.isEmpty() && map.getOrDefault(maxHeap.peek(), 0) > 0) {\n                int ele = maxHeap.peek();\n                maxHeap.poll();\n                map.put(ele, map.get(ele) - 1);\n            }\n\n            while (!minHeap.isEmpty() && map.getOrDefault(minHeap.peek(), 0) > 0) {\n                int ele = minHeap.peek();\n                minHeap.poll();\n                map.put(ele, map.get(ele) - 1);\n            }\n\n            j = j + 1;\n            res[j] = k % 2 == 1 ? maxHeap.peek() : ((double) maxHeap.peek() + minHeap.peek()) / 2;\n        }\n\n        return res;\n        \n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
