      "updated": 1767608399807,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public ListNode oddEvenList(ListNode head) {\n        if (head == null || head.next == null) {\n            return head;\n        }\n\n        ListNode curr1 = head,\n            curr2 = head.next;\n\n        ListNode temp1 = curr2;\n\n        // 1 -> 2 -> 3 -> 4\n        //           1\n        //                2\n        // 1 -> 3 -> 4\n        //.     1\n        // 2 -> 4 -> null\n        //      2\n        // T: O(n), S: O(1)\n        while (curr2 != null && curr2.next != null) {\n            // body\n            curr1.next = curr2.next;\n            curr1 = curr1.next;\n            curr2.next = curr1.next;\n            curr2 = curr2.next;\n        }\n\n        curr1.next = temp1;\n\n        return head;\n    }\n}",
      "fontSize": 173.49999999999977,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public ListNode oddEvenList(ListNode head) {\n        if (head == null || head.next == null) {\n            return head;\n        }\n\n        ListNode curr1 = head,\n            curr2 = head.next;\n\n        ListNode temp1 = curr2;\n\n        // 1 -> 2 -> 3 -> 4\n        //           1\n        //                2\n        // 1 -> 3 -> 4\n        //.     1\n        // 2 -> 4 -> null\n        //      2\n        // T: O(n), S: O(1)\n        while (curr2 != null && curr2.next != null) {\n            // body\n            curr1.next = curr2.next;\n            curr1 = curr1.next;\n            curr2.next = curr1.next;\n            curr2 = curr2.next;\n        }\n\n        curr1.next = temp1;\n\n        return head;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
