      "isDeleted": true,
      "boundElements": [],
      "updated": 1770023292443,
      "link": null,
      "locked": false,
      "text": "ListNode reverseList(ListNode head) {\n        ListNode prev = null,\n            curr = head;\n\n        // T: O(n), S: O(1)\n        while (curr != null) {\n            // save next\n            ListNode next = curr.next;\n\n            // reverse the curr node\n            curr.next = prev;\n            prev = curr;\n            curr = next;\n        }\n\n        return prev;\n    }",
      "fontSize": 146.7873003920522,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "ListNode reverseList(ListNode head) {\n        ListNode prev = null,\n            curr = head;\n\n        // T: O(n), S: O(1)\n        while (curr != null) {\n            // save next\n            ListNode next = curr.next;\n\n            // reverse the curr node\n            curr.next = prev;\n            prev = curr;\n            curr = next;\n        }\n\n        return prev;\n    }",
      "autoResize": true,
      "lineHeight": 1.25
    },
