      "groupIds": [],
      "frameId": "NTVDBqorPr_Mb9oJdREoW",
      "index": "baXV",
      "roundness": null,
      "seed": 1340715452,
      "version": 165,
      "versionNonce": 82638340,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1771223801181,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public static int minCost(int[] arr) {\n        // code here\n        // 4 3 2 6 -> 5\n        // 4 5 6 -> 9\n        // 9 6 -> 15\n        // 15\n        // 29\n        // min heap... elements array\n        // cost = 0\n        // while heap.size > 1\n        //     min1\n        //     min2\n        //.    cost = cost + min1 + min2\n        //     heap.add(min1 + min2)\n        // return cost\n        PriorityQueue<Integer> minHeap = new PriorityQueue<>();\n        \n        for (int rope : arr) {\n            minHeap.add(rope);\n        }\n        \n        // T: O(n.logn)\n        \n        // <4 3 2 6>\n        int cost = 0;\n        \n        // < s1 + s2 ,s3, s4, s5>\n        // s1, s2\n        // s1 + s2\n        // <15>\n        // min1 = 6\n        // min2 = 9\n        // cost = 29\n        // T: O(n.logn)\n        // n ropes... n - 1 merges\n        // (n - 1)(logn + logn + logn)\n        // (n)(logn)\n        // T: O(n.logn), S: O(n)\n        while (minHeap.size() > 1) {\n            int min1 = minHeap.poll();\n            int min2 = minHeap.poll();\n            \n            cost = cost + min1 + min2;\n            \n            minHeap.add(min1 + min2);\n        }\n        \n        return cost;  \n    }\n}",
      "fontSize": 213.01186375295123,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public static int minCost(int[] arr) {\n        // code here\n        // 4 3 2 6 -> 5\n        // 4 5 6 -> 9\n        // 9 6 -> 15\n        // 15\n        // 29\n        // min heap... elements array\n        // cost = 0\n        // while heap.size > 1\n        //     min1\n        //     min2\n        //.    cost = cost + min1 + min2\n        //     heap.add(min1 + min2)\n        // return cost\n        PriorityQueue<Integer> minHeap = new PriorityQueue<>();\n        \n        for (int rope : arr) {\n            minHeap.add(rope);\n        }\n        \n        // T: O(n.logn)\n        \n        // <4 3 2 6>\n        int cost = 0;\n        \n        // < s1 + s2 ,s3, s4, s5>\n        // s1, s2\n        // s1 + s2\n        // <15>\n        // min1 = 6\n        // min2 = 9\n        // cost = 29\n        // T: O(n.logn)\n        // n ropes... n - 1 merges\n        // (n - 1)(logn + logn + logn)\n        // (n)(logn)\n        // T: O(n.logn), S: O(n)\n        while (minHeap.size() > 1) {\n            int min1 = minHeap.poll();\n            int min2 = minHeap.poll();\n            \n            cost = cost + min1 + min2;\n            \n            minHeap.add(min1 + min2);\n        }\n        \n        return cost;  \n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
