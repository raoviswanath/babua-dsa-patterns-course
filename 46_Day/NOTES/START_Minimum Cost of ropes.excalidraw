    {
      "id": "pRxvEaA5VLAQTRV2GOxHA",
      "type": "text",
      "x": 1438.1677383981812,
      "y": 35698.943616981305,
      "width": 2252.7729808530753,
      "height": 6801.056383018692,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "NTVDBqorPr_Mb9oJdREoW",
      "index": "bCKV",
      "roundness": null,
      "seed": 34558698,
      "version": 132,
      "versionNonce": 1543291708,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1771223801181,
      "link": null,
      "locked": false,
      "text": "class SummaryRanges {\n    List<Integer> list;\n\n    // T: O(1), S: O(1)\n    public SummaryRanges() {\n        list = new ArrayList<Integer>();\n    }\n    \n    // One call: T: O(n), S: O(1)\n    // m calls: T: O(m.n), S: O(m)\n    public void addNum(int value) {\n        if (list.contains(value)) {\n            return;\n        }\n        list.add(value);\n    }\n    \n    // 1, 3, 7, 2\n    // [1, 2, 3, 7]\n    // One call: T: O(n.logn), S: O(n)\n    // m calls: T: O(m.n.logn), S: O(n + logn)\n    // [1, 2, 3, 7]\n    // [1,3][7,7]\n\n    public int[][] getIntervals() {\n        if (list.size() == 0) {\n            return new int[][] {};\n        }\n        Collections.sort(list);\n\n        // initially,\n        // left, right should be null\n        Integer left = null,\n            right = null;\n\n        List<int[]> res = new ArrayList<>();\n\n        // [1, 2, 3, 7]\n        // [6, 6]\n        // [6,6], [6,6]\n        // [6,6]\n        // O [1, 2, 3, 7]\n        //.               i\n        //             l\n        //             r\n        // [1,3], [7,7]\n        for (int i = 0; i < list.size(); i = i + 1) {\n            if (left == null && right == null) {\n                left = list.get(i);\n                right = list.get(i);\n            } else if (list.get(i) == right + 1) {\n                right = list.get(i);\n            } else {\n                res.add(new int[] {\n                    left, right\n                });\n                left = list.get(i);\n                right = list.get(i);\n            }\n        }\n\n        res.add(new int[] {\n            left, right\n        });\n\n        // list -> 2d array\n        int[][] ans = new int[res.size()][2];\n\n        for (int i = 0; i < res.size(); i = i + 1) {\n            ans[i] = res.get(i);\n        }\n\n        return ans;\n    }\n}\n\n/**\n * Your SummaryRanges object will be instantiated and called as such:\n * SummaryRanges obj = new SummaryRanges();\n * obj.addNum(value);\n * int[][] param_2 = obj.getIntervals();\n */",
      "fontSize": 66.3517695904262,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class SummaryRanges {\n    List<Integer> list;\n\n    // T: O(1), S: O(1)\n    public SummaryRanges() {\n        list = new ArrayList<Integer>();\n    }\n    \n    // One call: T: O(n), S: O(1)\n    // m calls: T: O(m.n), S: O(m)\n    public void addNum(int value) {\n        if (list.contains(value)) {\n            return;\n        }\n        list.add(value);\n    }\n    \n    // 1, 3, 7, 2\n    // [1, 2, 3, 7]\n    // One call: T: O(n.logn), S: O(n)\n    // m calls: T: O(m.n.logn), S: O(n + logn)\n    // [1, 2, 3, 7]\n    // [1,3][7,7]\n\n    public int[][] getIntervals() {\n        if (list.size() == 0) {\n            return new int[][] {};\n        }\n        Collections.sort(list);\n\n        // initially,\n        // left, right should be null\n        Integer left = null,\n            right = null;\n\n        List<int[]> res = new ArrayList<>();\n\n        // [1, 2, 3, 7]\n        // [6, 6]\n        // [6,6], [6,6]\n        // [6,6]\n        // O [1, 2, 3, 7]\n        //.               i\n        //             l\n        //             r\n        // [1,3], [7,7]\n        for (int i = 0; i < list.size(); i = i + 1) {\n            if (left == null && right == null) {\n                left = list.get(i);\n                right = list.get(i);\n            } else if (list.get(i) == right + 1) {\n                right = list.get(i);\n            } else {\n                res.add(new int[] {\n                    left, right\n                });\n                left = list.get(i);\n                right = list.get(i);\n            }\n        }\n\n        res.add(new int[] {\n            left, right\n        });\n\n        // list -> 2d array\n        int[][] ans = new int[res.size()][2];\n\n        for (int i = 0; i < res.size(); i = i + 1) {\n            ans[i] = res.get(i);\n        }\n\n        return ans;\n    }\n}\n\n/**\n * Your SummaryRanges object will be instantiated and called as such:\n * SummaryRanges obj = new SummaryRanges();\n * obj.addNum(value);\n * int[][] param_2 = obj.getIntervals();\n */",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
