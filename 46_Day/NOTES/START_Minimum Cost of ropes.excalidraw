      "updated": 1767343461612,
      "link": null,
      "locked": false,
      "text": "class SummaryRanges {\n    TreeSet<Integer> list;\n\n    // T: O(1), S: O(1)\n    public SummaryRanges() {\n        list = new TreeSet<Integer>();\n    }\n    \n    // One call: T: O(logn), S: O(1)\n    // m calls: T: O(m.logn), S: O(m)\n    public void addNum(int value) {\n        // if (list.contains(value)) {\n        //     return;\n        // }\n        list.add(value);\n    }\n    \n    // 1, 3, 7, 2\n    // [1, 2, 3, 7]\n    // One call: T: O(n), S: O(n)\n    // m calls: T: O(m.n), S: O(n)\n    public int[][] getIntervals() {\n        if (list.size() == 0) {\n            return new int[][] {};\n        }\n\n        // initially,\n        // left, right should be null\n        Integer left = null,\n            right = null;\n\n        List<int[]> res = new ArrayList<>();\n\n        //  O {1, 2, 3, 7}\n        //.                v     \n        //              l\n        //              r\n        // [1,3], [7,7]\n        // list = {1 2 3 7}\n        //             v\n        for (Integer val : list) {\n            if (left == null && right == null) {\n                left = val;\n                right = val;\n            } else if (val == right + 1) {\n                right = val;\n            } else {\n                res.add(new int[] {\n                    left, right\n                });\n                left = val;\n                right = val;\n            }\n        }\n\n        res.add(new int[] {\n            left, right\n        });\n\n        // list -> 2d array\n        int[][] ans = new int[res.size()][2];\n\n        for (int i = 0; i < res.size(); i = i + 1) {\n            ans[i] = res.get(i);\n        }\n\n        return ans;\n    }\n}\n\n/**\n * Your SummaryRanges object will be instantiated and called as such:\n * SummaryRanges obj = new SummaryRanges();\n * obj.addNum(value);\n * int[][] param_2 = obj.getIntervals();\n */",
      "fontSize": 66.3517695904262,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class SummaryRanges {\n    TreeSet<Integer> list;\n\n    // T: O(1), S: O(1)\n    public SummaryRanges() {\n        list = new TreeSet<Integer>();\n    }\n    \n    // One call: T: O(logn), S: O(1)\n    // m calls: T: O(m.logn), S: O(m)\n    public void addNum(int value) {\n        // if (list.contains(value)) {\n        //     return;\n        // }\n        list.add(value);\n    }\n    \n    // 1, 3, 7, 2\n    // [1, 2, 3, 7]\n    // One call: T: O(n), S: O(n)\n    // m calls: T: O(m.n), S: O(n)\n    public int[][] getIntervals() {\n        if (list.size() == 0) {\n            return new int[][] {};\n        }\n\n        // initially,\n        // left, right should be null\n        Integer left = null,\n            right = null;\n\n        List<int[]> res = new ArrayList<>();\n\n        //  O {1, 2, 3, 7}\n        //.                v     \n        //              l\n        //              r\n        // [1,3], [7,7]\n        // list = {1 2 3 7}\n        //             v\n        for (Integer val : list) {\n            if (left == null && right == null) {\n                left = val;\n                right = val;\n            } else if (val == right + 1) {\n                right = val;\n            } else {\n                res.add(new int[] {\n                    left, right\n                });\n                left = val;\n                right = val;\n            }\n        }\n\n        res.add(new int[] {\n            left, right\n        });\n\n        // list -> 2d array\n        int[][] ans = new int[res.size()][2];\n\n        for (int i = 0; i < res.size(); i = i + 1) {\n            ans[i] = res.get(i);\n        }\n\n        return ans;\n    }\n}\n\n/**\n * Your SummaryRanges object will be instantiated and called as such:\n * SummaryRanges obj = new SummaryRanges();\n * obj.addNum(value);\n * int[][] param_2 = obj.getIntervals();\n */",
