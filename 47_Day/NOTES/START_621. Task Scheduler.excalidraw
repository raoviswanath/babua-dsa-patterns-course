      "seed": 1169299953,
      "version": 64,
      "versionNonce": 444238417,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1770796318333,
      "link": null,
      "locked": false,
      "text": "class Task {\n    int freq;\n    int time;\n\n    public Task(int f, int t) {\n        this.freq = f;\n        this.time = t;\n    }\n}\n\nclass Solution {\n    public int leastInterval(char[] tasks, int n) {\n        // Task -> freq... time...\n        // A: 5, 1\n        // 1\n        // max heap -> available tasks\n        // queue of tasks ... \n        // maxHeap... queue...\n        int time = 0;\n        // A: 2, B: 1, C: 1\n        // \"A\", \"B\", \"C\", \"A\"\n        // n = 1\n        PriorityQueue<Task> maxHeap = new PriorityQueue<>((a, b) -> b.freq - a.freq);\n        Queue<Task> queue = new LinkedList<>();\n\n        // A, A, B, A\n        // 0: A: 3\n        // 1: B: 1\n        int[] counts = new int[26];\n        // C\n        // C - 'A' -> 2\n        // T: O(N)\n        // S: O(1)\n        for (char t : tasks) {\n            // n tasks\n            counts[t - 'A'] = counts[t - 'A'] + 1;\n        }\n\n        // A: 2, B: 1, C: 1\n        // <(2:1), (1: 1), (1: 1)>\n        // T: O(N)\n        // S: O(1)\n        // 26\n        for (int c : counts) {\n            if (c > 0) {\n                maxHeap.add(new Task(c, 1));\n            }\n        }\n        // <>\n        // []\n        // time = 4\n        // T = (0: 6)\n        // T: O(N)\n        // S: O(1)\n        // 26 elements\n        // N\n        // A: 2, B: 1, C: 1\n        // ABAC\n        // n = 1\n        // T: O(N), S: O(1)\n        // A: 10\n        // A, A, A... 10\n        // n = 500\n        // A________\n        // T: O(N.n), S: O(1)\n        while (!maxHeap.isEmpty() || !queue.isEmpty()) {\n            time = time + 1;\n            // 2: A\n            // 6: A\n\n            while (!queue.isEmpty() && queue.peek().time == time) {\n                maxHeap.add(queue.poll());\n            }\n\n            if (!maxHeap.isEmpty()) {\n                Task taskToExecute = maxHeap.poll();\n\n                taskToExecute.freq = taskToExecute.freq - 1;\n\n                taskToExecute.time = time + (n + 1);\n\n                if (taskToExecute.freq > 0) {\n                    queue.add(new Task(taskToExecute.freq, taskToExecute.time));\n                }\n            }\n        }\n\n        return time;\n    }\n}",
      "fontSize": 204.0686497228442,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Task {\n    int freq;\n    int time;\n\n    public Task(int f, int t) {\n        this.freq = f;\n        this.time = t;\n    }\n}\n\nclass Solution {\n    public int leastInterval(char[] tasks, int n) {\n        // Task -> freq... time...\n        // A: 5, 1\n        // 1\n        // max heap -> available tasks\n        // queue of tasks ... \n        // maxHeap... queue...\n        int time = 0;\n        // A: 2, B: 1, C: 1\n        // \"A\", \"B\", \"C\", \"A\"\n        // n = 1\n        PriorityQueue<Task> maxHeap = new PriorityQueue<>((a, b) -> b.freq - a.freq);\n        Queue<Task> queue = new LinkedList<>();\n\n        // A, A, B, A\n        // 0: A: 3\n        // 1: B: 1\n        int[] counts = new int[26];\n        // C\n        // C - 'A' -> 2\n        // T: O(N)\n        // S: O(1)\n        for (char t : tasks) {\n            // n tasks\n            counts[t - 'A'] = counts[t - 'A'] + 1;\n        }\n\n        // A: 2, B: 1, C: 1\n        // <(2:1), (1: 1), (1: 1)>\n        // T: O(N)\n        // S: O(1)\n        // 26\n        for (int c : counts) {\n            if (c > 0) {\n                maxHeap.add(new Task(c, 1));\n            }\n        }\n        // <>\n        // []\n        // time = 4\n        // T = (0: 6)\n        // T: O(N)\n        // S: O(1)\n        // 26 elements\n        // N\n        // A: 2, B: 1, C: 1\n        // ABAC\n        // n = 1\n        // T: O(N), S: O(1)\n        // A: 10\n        // A, A, A... 10\n        // n = 500\n        // A________\n        // T: O(N.n), S: O(1)\n        while (!maxHeap.isEmpty() || !queue.isEmpty()) {\n            time = time + 1;\n            // 2: A\n            // 6: A\n\n            while (!queue.isEmpty() && queue.peek().time == time) {\n                maxHeap.add(queue.poll());\n            }\n\n            if (!maxHeap.isEmpty()) {\n                Task taskToExecute = maxHeap.poll();\n\n                taskToExecute.freq = taskToExecute.freq - 1;\n\n                taskToExecute.time = time + (n + 1);\n\n                if (taskToExecute.freq > 0) {\n                    queue.add(new Task(taskToExecute.freq, taskToExecute.time));\n                }\n            }\n        }\n\n        return time;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
