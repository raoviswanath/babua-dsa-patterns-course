      "text": "class Solution {\n    public int smallestChair(int[][] times, int targetFriend) {\n        // 0 ... 1-4 - 0\n        // 1 ... 2-3 - 1\n        // \n        // sort times by start time\n        // n chairs\n        // linear data structure... array jo store karega end times of chairs\n        // 0 end time for chairs initially...\n        // meaning all chairs are available initially\n        // times = [[3,10],[1,5],[2,6]], targetFriend = 0\n        int targetFriendArrivalTime = times[targetFriend][0]; // 3\n        // T: O(n.logn), S: O(logn)\n        Arrays.sort(times, (a, b) -> a[0] - b[0]);\n        // times = [[1,5], [2,6], [3,10]], targetFriend = 0\n        // sort times by arrival times\n        int[] chairs = new int[times.length]; // end time of chair\n        // initialised with 0\n\n        // T: O(n^2), S: O(n)\n        // times = [[1,5], [2,6], [3,10]], targetFriend = 0\n        //                         i\n        // [ 5, 6, 0]\n        //         j\n        for (int i = 0; i < times.length; i = i + 1) {\n            // processing current friend i\n            for (int j = 0; j < chairs.length; j = j + 1) {\n                if (times[i][0] >= chairs[j]) {\n                    if (targetFriendArrivalTime == times[i][0]) {\n                        return j;\n                    }\n                    chairs[j] = times[i][1];\n                    break;\n                }\n            }\n        }\n\n        return -1;\n    }\n}",
      "fontSize": 133.96869051328824,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public int smallestChair(int[][] times, int targetFriend) {\n        // 0 ... 1-4 - 0\n        // 1 ... 2-3 - 1\n        // \n        // sort times by start time\n        // n chairs\n        // linear data structure... array jo store karega end times of chairs\n        // 0 end time for chairs initially...\n        // meaning all chairs are available initially\n        // times = [[3,10],[1,5],[2,6]], targetFriend = 0\n        int targetFriendArrivalTime = times[targetFriend][0]; // 3\n        // T: O(n.logn), S: O(logn)\n        Arrays.sort(times, (a, b) -> a[0] - b[0]);\n        // times = [[1,5], [2,6], [3,10]], targetFriend = 0\n        // sort times by arrival times\n        int[] chairs = new int[times.length]; // end time of chair\n        // initialised with 0\n\n        // T: O(n^2), S: O(n)\n        // times = [[1,5], [2,6], [3,10]], targetFriend = 0\n        //                         i\n        // [ 5, 6, 0]\n        //         j\n        for (int i = 0; i < times.length; i = i + 1) {\n            // processing current friend i\n            for (int j = 0; j < chairs.length; j = j + 1) {\n                if (times[i][0] >= chairs[j]) {\n                    if (targetFriendArrivalTime == times[i][0]) {\n                        return j;\n                    }\n                    chairs[j] = times[i][1];\n                    break;\n                }\n            }\n        }\n\n        return -1;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
