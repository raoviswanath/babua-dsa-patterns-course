    {
      "id": "7TYicrdKOT9v71PKRGWlq",
      "type": "text",
      "x": 3583.7179182332484,
      "y": 43642.27690618005,
      "width": 8461.292451112244,
      "height": 22957.723093819946,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "LTxoIgn1ovlruPgSz96b3",
      "index": "c02bV",
