    {
      "id": "Lv9jWxIQHSEnvMOxibMja",
      "type": "text",
      "x": 742.2693948847204,
      "y": 59478.479536835584,
      "width": 5751.0361328125,
      "height": 10382.573514779839,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "OivDEINOTSY30f7OH7VfD",
      "index": "bX7G",
      "roundness": null,
      "seed": 633553682,
      "version": 305,
      "versionNonce": 522511634,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769834697060,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public int smallestChair(int[][] times, int targetFriend) {\n        int targetFriendArrivalTime = times[targetFriend][0];\n\n        Arrays.sort(times, (a, b) -> a[0] - b[0]);\n\n        PriorityQueue<Integer> availableChairs = new PriorityQueue<>();\n        PriorityQueue<int[]> occupiedChairs = new PriorityQueue<>((a, b) -> a[0] - b[0]);\n        // times = [[3,10],[1,5],[2,6]], targetFriend = 0\n        // end time, index\n\n        // [[1,5], [2,6], [3,10]]\n        // targetFriendArrivalTime = 3\n\n        // all chairs are available\n        // <0, 1, 2>\n        // <>\n        for (int i = 0; i < times.length; i = i + 1) {\n            availableChairs.add(i);\n        }\n\n        // T: O(n.logn), S: O(n)\n        for (int i = 0; i < times.length; i = i + 1) {\n\n            // [[1,5], [2,6], [3,10]]\n            //.                i\n            // targetFriendArrivalTime = 3\n\n            // all chairs are available\n            // <2>\n            // <[5, 0], [6, 1]>\n            // aT = 1\n            // c = 2\n            // occupiedChairs ... remove all chairs whose\n            // endTime <= arrivalTime of friend\n            int aT = times[i][0];\n\n            while (!occupiedChairs.isEmpty()) {\n                if (aT >= occupiedChairs.peek()[0]) {\n                    int[] chair = occupiedChairs.poll();\n                    availableChairs.add(chair[1]);\n                } else {\n                    break;\n                }\n            }\n\n            // available chairs se jo bhi chair nikalenge... uspe apna bhai baithega...\n            int c = availableChairs.poll();\n\n            if (targetFriendArrivalTime == aT) {\n                return c;\n            }\n\n            occupiedChairs.add(new int[] {\n                times[i][1],\n                c\n            });\n        }\n\n        return -1;\n    }\n}",
      "fontSize": 133.96869051328824,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public int smallestChair(int[][] times, int targetFriend) {\n        int targetFriendArrivalTime = times[targetFriend][0];\n\n        Arrays.sort(times, (a, b) -> a[0] - b[0]);\n\n        PriorityQueue<Integer> availableChairs = new PriorityQueue<>();\n        PriorityQueue<int[]> occupiedChairs = new PriorityQueue<>((a, b) -> a[0] - b[0]);\n        // times = [[3,10],[1,5],[2,6]], targetFriend = 0\n        // end time, index\n\n        // [[1,5], [2,6], [3,10]]\n        // targetFriendArrivalTime = 3\n\n        // all chairs are available\n        // <0, 1, 2>\n        // <>\n        for (int i = 0; i < times.length; i = i + 1) {\n            availableChairs.add(i);\n        }\n\n        // T: O(n.logn), S: O(n)\n        for (int i = 0; i < times.length; i = i + 1) {\n\n            // [[1,5], [2,6], [3,10]]\n            //.                i\n            // targetFriendArrivalTime = 3\n\n            // all chairs are available\n            // <2>\n            // <[5, 0], [6, 1]>\n            // aT = 1\n            // c = 2\n            // occupiedChairs ... remove all chairs whose\n            // endTime <= arrivalTime of friend\n            int aT = times[i][0];\n\n            while (!occupiedChairs.isEmpty()) {\n                if (aT >= occupiedChairs.peek()[0]) {\n                    int[] chair = occupiedChairs.poll();\n                    availableChairs.add(chair[1]);\n                } else {\n                    break;\n                }\n            }\n\n            // available chairs se jo bhi chair nikalenge... uspe apna bhai baithega...\n            int c = availableChairs.poll();\n\n            if (targetFriendArrivalTime == aT) {\n                return c;\n            }\n\n            occupiedChairs.add(new int[] {\n                times[i][1],\n                c\n            });\n        }\n\n        return -1;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
