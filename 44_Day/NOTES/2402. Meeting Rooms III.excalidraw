      "versionNonce": 723121179,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769595761727,
      "link": null,
      "locked": false,
      "text": "class RoomEndTimesDetails {\n    long endTime;\n    int idx;\n\n    public RoomEndTimesDetails(long _endTime, int _idx) {\n        this.endTime = _endTime;\n        this.idx = _idx;\n    }\n}\n\nclass Solution {\n    public int mostBooked(int n, int[][] meetings) {\n        Arrays.sort(meetings, (a, b) -> a[0] - b[0]);\n\n        // minheap of available rooms\n        // minheap of occupied rooms... end times ke basis pe... end times are equal\n        // then index ke basis pe min heap\n        // occupied rooms mai room uthake available mai daal do agar daal sakte ho toh...\n        PriorityQueue<Integer> availableRooms = new PriorityQueue<>();\n        PriorityQueue<RoomEndTimesDetails> occupiedRooms = new PriorityQueue<>(\n            (a, b) -> {\n                if (a.endTime == b.endTime) {\n                    return a.idx - b.idx;\n                }\n\n                return Long.compare(a.endTime, b.endTime);\n            }\n        );\n        // n = 3, meetings = [[1,20],[2,10],[3,5],[4,9]]\n        // { 0, 1, 2 }\n        // T: O(n.logn + m.logm + m.logn)\n        for (int i = 0; i < n; i = i + 1) {\n            availableRooms.add(i);\n        }\n\n        int[] counts = new int[n];\n        \n        // n = 3, meetings = [[1,20],[2,10],[3,5],[4,9]]\n        //                                         i\n        // aR = { }\n        // 10: 2\n        // oR = { 20: 0, 10: 1, 10: 2 }\n        // counts = [1, 1, 2]\n        for (int i = 0; i < meetings.length; i = i + 1) {\n            int startTime = meetings[i][0];\n            int endTime = meetings[i][1];\n\n            int minEndTimeRoomIdx = 0;\n\n            boolean isRoomAllocated = false;\n\n            // 10: 0\n            // 3\n            while (!occupiedRooms.isEmpty()) {\n                if (startTime >= occupiedRooms.peek().endTime) {\n                    RoomEndTimesDetails rETD = occupiedRooms.poll();\n                    availableRooms.add(rETD.idx);\n                } else {\n                    break;\n                }\n            }\n\n            if (availableRooms.isEmpty()) {\n                RoomEndTimesDetails minEndTimeOccupiedRoomDetails = occupiedRooms.poll();\n                minEndTimeOccupiedRoomDetails.endTime = minEndTimeOccupiedRoomDetails.endTime + (endTime - startTime);\n                occupiedRooms.add(new RoomEndTimesDetails(minEndTimeOccupiedRoomDetails.endTime, minEndTimeOccupiedRoomDetails.idx));\n                counts[minEndTimeOccupiedRoomDetails.idx] = counts[minEndTimeOccupiedRoomDetails.idx] + 1;\n            } else {\n                int room = availableRooms.poll();\n                counts[room] = counts[room] + 1;\n                occupiedRooms.add(new RoomEndTimesDetails(endTime, room));\n            }\n\n        }\n\n        int maxRoomCountsIdx = 0;\n        for (int i = 0; i < n; i = i + 1) {\n            if (counts[i] > counts[maxRoomCountsIdx]) {\n                maxRoomCountsIdx = i;\n            }\n        }\n\n        return maxRoomCountsIdx;\n    }\n}",
      "fontSize": 84.4138191733145,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class RoomEndTimesDetails {\n    long endTime;\n    int idx;\n\n    public RoomEndTimesDetails(long _endTime, int _idx) {\n        this.endTime = _endTime;\n        this.idx = _idx;\n    }\n}\n\nclass Solution {\n    public int mostBooked(int n, int[][] meetings) {\n        Arrays.sort(meetings, (a, b) -> a[0] - b[0]);\n\n        // minheap of available rooms\n        // minheap of occupied rooms... end times ke basis pe... end times are equal\n        // then index ke basis pe min heap\n        // occupied rooms mai room uthake available mai daal do agar daal sakte ho toh...\n        PriorityQueue<Integer> availableRooms = new PriorityQueue<>();\n        PriorityQueue<RoomEndTimesDetails> occupiedRooms = new PriorityQueue<>(\n            (a, b) -> {\n                if (a.endTime == b.endTime) {\n                    return a.idx - b.idx;\n                }\n\n                return Long.compare(a.endTime, b.endTime);\n            }\n        );\n        // n = 3, meetings = [[1,20],[2,10],[3,5],[4,9]]\n        // { 0, 1, 2 }\n        // T: O(n.logn + m.logm + m.logn)\n        for (int i = 0; i < n; i = i + 1) {\n            availableRooms.add(i);\n        }\n\n        int[] counts = new int[n];\n        \n        // n = 3, meetings = [[1,20],[2,10],[3,5],[4,9]]\n        //                                         i\n        // aR = { }\n        // 10: 2\n        // oR = { 20: 0, 10: 1, 10: 2 }\n        // counts = [1, 1, 2]\n        for (int i = 0; i < meetings.length; i = i + 1) {\n            int startTime = meetings[i][0];\n            int endTime = meetings[i][1];\n\n            int minEndTimeRoomIdx = 0;\n\n            boolean isRoomAllocated = false;\n\n            // 10: 0\n            // 3\n            while (!occupiedRooms.isEmpty()) {\n                if (startTime >= occupiedRooms.peek().endTime) {\n                    RoomEndTimesDetails rETD = occupiedRooms.poll();\n                    availableRooms.add(rETD.idx);\n                } else {\n                    break;\n                }\n            }\n\n            if (availableRooms.isEmpty()) {\n                RoomEndTimesDetails minEndTimeOccupiedRoomDetails = occupiedRooms.poll();\n                minEndTimeOccupiedRoomDetails.endTime = minEndTimeOccupiedRoomDetails.endTime + (endTime - startTime);\n                occupiedRooms.add(new RoomEndTimesDetails(minEndTimeOccupiedRoomDetails.endTime, minEndTimeOccupiedRoomDetails.idx));\n                counts[minEndTimeOccupiedRoomDetails.idx] = counts[minEndTimeOccupiedRoomDetails.idx] + 1;\n            } else {\n                int room = availableRooms.poll();\n                counts[room] = counts[room] + 1;\n                occupiedRooms.add(new RoomEndTimesDetails(endTime, room));\n            }\n\n        }\n\n        int maxRoomCountsIdx = 0;\n        for (int i = 0; i < n; i = i + 1) {\n            if (counts[i] > counts[maxRoomCountsIdx]) {\n                maxRoomCountsIdx = i;\n            }\n        }\n\n        return maxRoomCountsIdx;\n    }\n}",
