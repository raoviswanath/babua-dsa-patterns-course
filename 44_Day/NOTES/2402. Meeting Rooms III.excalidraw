    {
      "id": "-ADECB7hJmJ4-h49bqPjG",
      "type": "text",
      "x": 3744.06632041616,
      "y": 28188.190959497086,
      "width": 6722.00244140625,
      "height": 11331.809040502922,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "hYkI5fLK9WTVlSOGd7Ub2",
      "index": "bXTV",
      "roundness": null,
      "seed": 457850043,
      "version": 80,
      "versionNonce": 1217484859,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769588936720,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public int mostBooked(int n, int[][] meetings) {\n        // n = 3, meetings = [[2,10],[1,20], [3,5],[4,9],[6,8]]\n        // output: 1\n        // sort meetings by start time... (Done)\n        // rooms array with end time 0 (Done)\n        // rooms count array with 0 (Done)\n        // for each meeting... (Done)\n        //     go through each room (Done)\n        //          if start time of meeting >= end time of room (Done)\n        //                we got a room\n        //                update end time of room with meeting end time\n        //                update count for room\n        //          we are calculating the room with minimum end time\n        //     if no room is allocated, give room with minimum end time\n        //          room[minimum end time] = room[minimum end time] + end_meeting_time - start_meeting_time\n        //          counts[minimum end time] = counts[minimum end time] + 1\n        // iterate through the counts and find the room with maximum count\n        Arrays.sort(meetings, (a, b) -> a[0] - b[0]);\n        // n = 3, meetings = [[1, 20], [2,10], [3,5],[4,9],[6,8]]\n        // m... T: O(m.logn), S: O(logm)\n\n        long[] endTimesOfRooms = new long[n];\n        int[] counts = new int[n];\n        // n = 3, meetings = [[1, 20], [2,10], [3,5],[4,9],[6,8]]\n        // endTim = [0, 0, 0]\n        // counts = [0, 0, 0]\n        // T: O(m.logn + n + m.n), S: O(logm + n)\n        // n = 3, meetings = [[1, 20], [2,10], [3,5], [4, 9]]\n        //                                             i\n        // 0 1 2\n        // r\n        // endTim = [20, 10, 10]\n        // counts = [1, 1, 2]\n        // minIdx = 2\n        for (int i = 0; i < meetings.length; i = i + 1) {\n            int startTime = meetings[i][0];\n            int endTime = meetings[i][1];\n\n            int minEndTimeRoomIdx = 0;\n\n            boolean isRoomAllocated = false;\n\n            for (int room = 0; room < n; room = room + 1) {\n                if (startTime >= endTimesOfRooms[room]) {\n                    endTimesOfRooms[room] = endTime;\n                    counts[room] = counts[room] + 1;\n                    isRoomAllocated = true;\n                    break;\n                }\n\n                if (endTimesOfRooms[room] < endTimesOfRooms[minEndTimeRoomIdx]) {\n                    minEndTimeRoomIdx = room;\n                }\n            }\n\n            if (!isRoomAllocated) {\n                endTimesOfRooms[minEndTimeRoomIdx] = endTimesOfRooms[minEndTimeRoomIdx] + endTime - startTime;\n                counts[minEndTimeRoomIdx] = counts[minEndTimeRoomIdx] + 1;\n            }\n        }\n\n        // 10^5\n        // 10^5\n        // 10^10\n        // 2 * 10^9\n\n        int maxRoomCountsIdx = 0;\n        // counts = [1, 1, 2]\n        //                 i\n        // \n        for (int i = 0; i < n; i = i + 1) {\n            if (counts[i] > counts[maxRoomCountsIdx]) {\n                maxRoomCountsIdx = i;\n            }\n        }\n\n        return maxRoomCountsIdx;\n    }\n}",
      "fontSize": 113.31809040502922,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public int mostBooked(int n, int[][] meetings) {\n        // n = 3, meetings = [[2,10],[1,20], [3,5],[4,9],[6,8]]\n        // output: 1\n        // sort meetings by start time... (Done)\n        // rooms array with end time 0 (Done)\n        // rooms count array with 0 (Done)\n        // for each meeting... (Done)\n        //     go through each room (Done)\n        //          if start time of meeting >= end time of room (Done)\n        //                we got a room\n        //                update end time of room with meeting end time\n        //                update count for room\n        //          we are calculating the room with minimum end time\n        //     if no room is allocated, give room with minimum end time\n        //          room[minimum end time] = room[minimum end time] + end_meeting_time - start_meeting_time\n        //          counts[minimum end time] = counts[minimum end time] + 1\n        // iterate through the counts and find the room with maximum count\n        Arrays.sort(meetings, (a, b) -> a[0] - b[0]);\n        // n = 3, meetings = [[1, 20], [2,10], [3,5],[4,9],[6,8]]\n        // m... T: O(m.logn), S: O(logm)\n\n        long[] endTimesOfRooms = new long[n];\n        int[] counts = new int[n];\n        // n = 3, meetings = [[1, 20], [2,10], [3,5],[4,9],[6,8]]\n        // endTim = [0, 0, 0]\n        // counts = [0, 0, 0]\n        // T: O(m.logn + n + m.n), S: O(logm + n)\n        // n = 3, meetings = [[1, 20], [2,10], [3,5], [4, 9]]\n        //                                             i\n        // 0 1 2\n        // r\n        // endTim = [20, 10, 10]\n        // counts = [1, 1, 2]\n        // minIdx = 2\n        for (int i = 0; i < meetings.length; i = i + 1) {\n            int startTime = meetings[i][0];\n            int endTime = meetings[i][1];\n\n            int minEndTimeRoomIdx = 0;\n\n            boolean isRoomAllocated = false;\n\n            for (int room = 0; room < n; room = room + 1) {\n                if (startTime >= endTimesOfRooms[room]) {\n                    endTimesOfRooms[room] = endTime;\n                    counts[room] = counts[room] + 1;\n                    isRoomAllocated = true;\n                    break;\n                }\n\n                if (endTimesOfRooms[room] < endTimesOfRooms[minEndTimeRoomIdx]) {\n                    minEndTimeRoomIdx = room;\n                }\n            }\n\n            if (!isRoomAllocated) {\n                endTimesOfRooms[minEndTimeRoomIdx] = endTimesOfRooms[minEndTimeRoomIdx] + endTime - startTime;\n                counts[minEndTimeRoomIdx] = counts[minEndTimeRoomIdx] + 1;\n            }\n        }\n\n        // 10^5\n        // 10^5\n        // 10^10\n        // 2 * 10^9\n\n        int maxRoomCountsIdx = 0;\n        // counts = [1, 1, 2]\n        //                 i\n        // \n        for (int i = 0; i < n; i = i + 1) {\n            if (counts[i] > counts[maxRoomCountsIdx]) {\n                maxRoomCountsIdx = i;\n            }\n        }\n\n        return maxRoomCountsIdx;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
