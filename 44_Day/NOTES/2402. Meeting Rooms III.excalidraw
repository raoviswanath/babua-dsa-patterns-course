      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "vQFfAo7V-ZMw9uHZqzh-K",
      "index": "blNV",
      "roundness": null,
      "seed": 923704539,
