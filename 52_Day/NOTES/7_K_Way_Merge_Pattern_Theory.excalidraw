      "updated": 1771830483715,
      "link": null,
      "locked": false,
      "text": "Time complexity: O(N.logK)\n\nWhere N is the total number of elements across the K lists\nEach element:\n- Inserted once\n- Removed once",
      "fontSize": 68.37187500000002,
      "fontFamily": 5,
      "textAlign": "left",
