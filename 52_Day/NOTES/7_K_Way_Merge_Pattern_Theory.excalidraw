    {
      "id": "ycSbhMOnDXnPG9lmai0_e",
      "type": "text",
      "x": 260,
      "y": 17620,
      "width": 2233.439697265625,
      "height": 3300.0000000000177,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "pKcqtBtqA1u0rCL-MsqAP",
      "index": "b8Il",
      "roundness": null,
      "seed": 1875654909,
      "version": 1207,
      "versionNonce": 336786989,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771831064054,
      "link": null,
      "locked": false,
      "text": "sortedLists = ...\n\n# Create a min heap\nminHeap = new MinHeap()\n\n# push the first element from each sorted list\ninto the heap\nfor index from 0 to length(sortedLists) - 1:\n    if sortedLists[index] is not empty:\n        firstValue = sortedLists[index][0]\n        minHeap.add((firstValue, index, 0))\n\n# Result container\nresult = []\n\n# Continue until heap becomes empty\nwhile minHeap is not empty:\n    \n    # remove the smallest element\n    (val, listId, elementId) = minHeap.poll()\n\n    # Add to final result\n    result.add(val)\n\n    # Check if there is a next element in the same source\n    list\n    nextElementId = elementId + 1\n\n    if nextElementId < length(sortedLists[listId]):\n        nextVal = sortedLists[listId][nextElementId]\n        minHeap.add((nextVal, listId, nextElementId))\n\nReturn result",
      "fontSize": 80.00000000000043,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "sortedLists = ...\n\n# Create a min heap\nminHeap = new MinHeap()\n\n# push the first element from each sorted list\ninto the heap\nfor index from 0 to length(sortedLists) - 1:\n    if sortedLists[index] is not empty:\n        firstValue = sortedLists[index][0]\n        minHeap.add((firstValue, index, 0))\n\n# Result container\nresult = []\n\n# Continue until heap becomes empty\nwhile minHeap is not empty:\n    \n    # remove the smallest element\n    (val, listId, elementId) = minHeap.poll()\n\n    # Add to final result\n    result.add(val)\n\n    # Check if there is a next element in the same source\n    list\n    nextElementId = elementId + 1\n\n    if nextElementId < length(sortedLists[listId]):\n        nextVal = sortedLists[listId][nextElementId]\n        minHeap.add((nextVal, listId, nextElementId))\n\nReturn result",
      "autoResize": true,
      "lineHeight": 1.25
    },
