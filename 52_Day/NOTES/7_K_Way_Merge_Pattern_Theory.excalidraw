    {
      "id": "bqWR1jr3Ar9WaZ4RMmPav",
      "type": "text",
      "x": 380,
      "y": 4120,
      "width": 1070.742431640625,
      "height": 940.1132812500003,
      "angle": 0,
      "strokeColor": "#9c36b5",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "hachure",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "Vt38fKmlImgU-Gi98hb34",
      "index": "bEH",
      "roundness": null,
      "seed": 1060163405,
      "version": 764,
      "versionNonce": 1793563277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1771839827182,
      "link": null,
      "locked": false,
      "text": "lists = [[1,2,3], [2,3,4], [4,5,6]]\n\ncombined_list = []\n\nfor l in lists:\n    combined_list.add(l)\n\n# [1, 2, 3, 2, 3, 4, 4, 5, 6]\nsort(combined_list)\n\n# [1, 2, 2, 3, 3, 4, 4, 5, 6]",
      "fontSize": 68.37187500000002,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "lists = [[1,2,3], [2,3,4], [4,5,6]]\n\ncombined_list = []\n\nfor l in lists:\n    combined_list.add(l)\n\n# [1, 2, 3, 2, 3, 4, 4, 5, 6]\nsort(combined_list)\n\n# [1, 2, 2, 3, 3, 4, 4, 5, 6]",
      "autoResize": true,
      "lineHeight": 1.25
    },
